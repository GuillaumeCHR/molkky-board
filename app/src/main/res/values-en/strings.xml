    <string name="credits_production">Production</string>
    <string name="credits_production_name">Yogi Studio</string>
    <string name="credits_production_note">Independent studio, total headcount: one person and a pin in the lotus position.</string>
    <string name="credits_dev">Development, design, testing and customer support</string>
    <string name="credits_dev_name">Yogi</string>
    <string name="credits_dev_note">Also played the intern, the project manager and the Product Owner. Meetings were short. Any resemblance to the pin in the logo is entirely intentional.</string>
    <string name="credits_pair">Pair programming</string>
    <string name="credits_pair_name">Claude (Anthropic), via Claude Code</string>
    <string name="credits_pair_note">Has never thrown a single pin, but knows the back-to-25 rule by heart.</string>
    <string name="credits_engine">Scoring engine</string>
    <string name="credits_engine_name">A pure function</string>
    <string name="credits_engine_note">No side effects. The same cannot be said of a mölkky thrown too hard.</string>
    <string name="credits_physics">Pin physics</string>
    <string name="credits_physics_name">Isaac Newton</string>
    <string name="credits_physics_note">Posthumous consultant, unpaid. Gravity worked first time.</string>
    <string name="credits_art">Art direction</string>
    <string name="credits_art_name">“Nordic Bold”</string>
    <string name="credits_art_note">Birch #F4EBDD, forest #1F4D3A, saffron #F2A93B, coral #E8604C. No trees were cut down to make this app.</string>
    <string name="credits_fonts">Typefaces</string>
    <string name="credits_fonts_names">Bricolage Grotesque — Mathieu Triay — SIL Open Font License 1.1\nInter — Rasmus Andersson — SIL Open Font License 1.1</string>
    <string name="credits_fonts_note">Tabular figures on: the scores don\'t jump, only the pins fall.</string>
    <string name="credits_game_title">The game</string>
    <string name="credits_game">Mölkky was invented in Finland in 1996. Kiitos!\nThe rules shown in the app are reworded from the official rules.\nMölkky® is a trademark of Tactic Games Oy. Molkky Board is an independent app, neither affiliated with nor endorsed by the trademark owner.</string>
    <string name="credits_hardware_title">Test hardware</string>
    <string name="credits_hardware">A valiant laptop running Zorin OS and its Android emulator</string>
    <string name="credits_hardware_note">Fans in “take-off” mode during every Gradle build. No laptop was harmed. Almost.</string>
