<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MolkkyBoard" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/birch</item>
    </style>

    <style name="Theme.MolkkyBoard.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/birch</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/forest</item>
        <item name="postSplashScreenTheme">@style/Theme.MolkkyBoard</item>
    </style>
</resources>
