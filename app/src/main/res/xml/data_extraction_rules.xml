<?xml version="1.0" encoding="utf-8"?>
<!-- Sauvegarde cloud désactivée ; seul le transfert d'appareil à appareil est autorisé. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
</data-extraction-rules>
